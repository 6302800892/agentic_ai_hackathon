# Copy to .env and fill in. Never commit .env.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_LIGHT=gemini-3.5-flash-lite

# Salt for HMAC patient_ref tokens + MCP session tokens (any long random string)
PHI_HMAC_SALT=change-me-to-a-long-random-string

# Observability
PHOENIX_PROJECT_NAME=patient-intake-copilot
# Leave empty to launch Phoenix in-process; or point at `phoenix serve` (http://localhost:6006)
# or Phoenix Cloud (https://app.phoenix.arize.com/s/<your-space>)
PHOENIX_COLLECTOR_ENDPOINT=
# Only needed for Phoenix Cloud / an auth-enabled Phoenix server
PHOENIX_API_KEY=

# Retrieval backend: chroma (default) | keyword (offline fallback, no model download)
COPILOT_RAG_BACKEND=chroma

# Disable DeepEval telemetry
DEEPEVAL_TELEMETRY_OPT_OUT=YES
